node_modules
gen/
@cds-models/

# Database
db/*.db
db/*.db-shm
db/*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Packaging (npm pack / publish output)
*.tgz

# In-place TypeScript build output
src/**/*.js
src/**/*.d.ts
src/**/*.js.map
src/**/*.d.ts.map
# ...except the browser entry's declarations, which are SOURCE: src/browser ships hand-written
# .mjs with hand-written .d.ts/.d.mts siblings and has no .ts to generate them from. The glob
# above treated them as build output, so they were never tracked — a fresh clone would publish
# @odatano/nightgate/browser with no types at all (scripts/check-package-exports.mjs now fails
# on exactly that).
!src/browser/*.d.ts
# Same story for the client SDK and the txbuilder (0.17.0): hand-written .mjs
# with hand-written .d.ts siblings, no .ts source to generate them from.
!src/sdk/client.d.ts
!src/sdk/index.d.ts
!src/txbuilder/index.d.ts
srv/**/*.js
srv/**/*.d.ts
srv/**/*.js.map
srv/**/*.d.ts.map

# Environment (backups from rekeying carry live secrets — never commit)
.env
.env.local
.env.*.local
.env.backup*

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

