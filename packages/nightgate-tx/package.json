{
    "name": "@odatano/nightgate-tx",
    "version": "0.22.0",
    "description": "NIGHTGATE client SDK: drive a hosted NIGHTGATE (ZK attestations, verification, disclosure, fee sponsoring) and build transactions locally with your own key.",
    "license": "Apache-2.0",
    "author": "ODATANO",
    "homepage": "https://github.com/ODATANO/NIGHTGATE#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ODATANO/NIGHTGATE.git",
        "directory": "packages/nightgate-tx"
    },
    "bugs": {
        "url": "https://github.com/ODATANO/NIGHTGATE/issues"
    },
    "keywords": [
        "midnight",
        "nightgate",
        "zero-knowledge",
        "attestation",
        "sdk",
        "fee-sponsoring",
        "agent"
    ],
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prepublishOnly": "node ../../scripts/build-slim-package.mjs && node ../../scripts/check-slim-package.mjs && git -C ../.. diff --quiet -- packages/nightgate-tx"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./src/sdk/index.d.ts",
            "import": "./src/sdk/index.mjs",
            "default": "./src/sdk/index.mjs"
        },
        "./client": {
            "types": "./src/sdk/client.d.ts",
            "import": "./src/sdk/client.mjs",
            "default": "./src/sdk/client.mjs"
        },
        "./txbuilder": {
            "types": "./src/txbuilder/index.d.ts",
            "import": "./src/txbuilder/index.mjs",
            "default": "./src/txbuilder/index.mjs"
        },
        "./calls": {
            "types": "./src/browser/index.d.ts",
            "import": "./src/browser/index.mjs",
            "default": "./src/browser/index.mjs"
        },
        "./set-root": {
            "types": "./srv/submission/set-root.d.ts",
            "default": "./srv/submission/set-root.js"
        },
        "./attestation-vault": {
            "types": "./src/browser/attestation-vault.d.mts",
            "default": "./src/browser/attestation-vault.mjs"
        },
        "./attestation-vault-32": {
            "types": "./src/browser/attestation-vault-32.d.mts",
            "default": "./src/browser/attestation-vault-32.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src/**/*.mjs",
        "src/**/*.d.ts",
        "src/**/*.d.mts",
        "srv/**/*.js",
        "srv/**/*.d.ts",
        "README.md",
        "LICENSE",
        "example/anchor.mjs",
        "example/self-funded.mjs"
    ],
    "dependencies": {
        "@midnight-ntwrk/compact-js": "3.0.0",
        "@midnight-ntwrk/compact-runtime": "0.21.0",
        "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
        "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
        "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
        "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
        "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
        "@midnight-ntwrk/midnight-js-types": "5.0.0",
        "@midnight-ntwrk/midnight-js-utils": "5.0.0",
        "@midnight-ntwrk/wallet-sdk-address-format": "npm:@midnightntwrk/wallet-sdk-address-format@4.0.0",
        "@midnightntwrk/ledger-v8": "8.1.3",
        "@midnightntwrk/ledger-v9": "1.0.0",
        "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
        "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
        "@midnightntwrk/wallet-sdk-capabilities": "4.0.0",
        "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0",
        "@midnightntwrk/wallet-sdk-facade": "5.0.0",
        "@midnightntwrk/wallet-sdk-hd": "4.0.0",
        "@midnightntwrk/wallet-sdk-prover-client": "2.0.0",
        "@midnightntwrk/wallet-sdk-shielded": "4.0.0",
        "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0",
        "@midnightntwrk/zkir-v2": "2.2.0",
        "@midnightntwrk/zkir-v3": "3.2.0",
        "@noble/hashes": "^1.8.0",
        "@odatano/contract-attestation-vault": "0.2.0",
        "@odatano/contract-attestation-vault-32": "0.2.0",
        "@odatano/contract-kit": "0.2.1",
        "@scure/base": "^2.2.0",
        "bip39": "^3.1.0",
        "ws": "^8"
    },
    "peerDependencies": {
        "@polkadot/api": ">=14"
    },
    "peerDependenciesMeta": {
        "@polkadot/api": {
            "optional": true
        }
    }
}
