// Minimal Compact contract, registered as the `counter` artifact.
// Mirrors example-counter (github.com/midnightntwrk/example-counter).

pragma language_version >= 0.20;

import CompactStandardLibrary;

// public state, round number, persisted on-chain
export ledger round: Counter;

// circuit: increment the counter by 1
export circuit increment(): [] {
  round.increment(1);
}
