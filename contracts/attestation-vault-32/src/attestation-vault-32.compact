// AttestationVault32: the 32-slot (depth-5) WIDTH VARIANT of the attestation
// vault, registered as `attestation-vault-32`.
//
// Identical circuit set and semantics to contracts/attestation-vault, tree
// width doubled to 32 provable fields: for panels of 17-32 fields that need
// ONE root (a global "at least k of 32 differ" claim only exists within one
// document). A SECOND lineage next to the 16-slot vault, never a
// replacement: cross-root proofs only work between documents of the SAME
// width (the tree shapes are incompatible), so an ecosystem picks its width
// per document family. Deploy size equals the 16-slot vault (every verifier
// key has the same size).
//
// Width changes vs. the 16-slot vault (everything else is a verbatim copy):
//   - inclusion proofs: depth 4 -> 5 (merkle_siblings/dirs Vector<5>)
//   - fold16 -> fold32, schemaRootOf/contentRootOf over Vector<32, ...>
//   - allowed_mask Vector<16, Boolean> -> Vector<32, Boolean>, k <= 32
//
pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---- Ledger ----------------------------------------------------------------

// One attestation per record key. `document_id` is the bound external
// identifier (zero = none).
struct Attestation {
  payload_hash:  Bytes<32>,
  metadata_hash: Bytes<32>,
  owner:         Bytes<32>,
  document_id:   Bytes<32>
}

// The Merkle root over the document's provable fields plus the schema root
// over the ordered field list it was built from.
struct ContentAnchor {
  root:   Bytes<32>,
  schema: Bytes<32>
}

export ledger attestations:      Map<Bytes<32>, Attestation>;
export ledger content_anchors:   Map<Bytes<32>, ContentAnchor>;
export ledger disclosures:       Map<Bytes<32>, Map<Bytes<32>, Uint<8>>>;

// document_id -> record_key, so an external document identifier resolves
// on-chain to its attestation. One id per record, one record per id.
export ledger document_bindings: Map<Bytes<32>, Bytes<32>>;

// Identifier-ownership pre-registration. The registrar may assign a
// document_id to an attester_id; bindDocument then accepts only that
// attester. Unregistered ids stay first-come-first-served.
export ledger registrar:         Bytes<32>;
export ledger document_owners:   Map<Bytes<32>, Bytes<32>>;

// Recovery identity for the registrar role: it may only re-point the
// registrar or hand itself over. Zero disables it.
export ledger recovery:          Bytes<32>;

// claim_key -> valid_until (block time). A recorded claim states that the
// value behind a field of the anchored content satisfies the claim's
// predicate; the key embeds the anchored root and schema, so a claim
// resolves only while that anchor stands. Expired claims are removed by
// anyone (retract mode 1).
export ledger claims:            Map<Bytes<32>, Uint<64>>;

// ---- Hashed structs --------------------------------------------------------
//
// transientHash and persistentHash hash the field-element sequence of a
// struct without a type tag, so every hashed struct carries its own tag as
// the first field.

// A provable numeric field: canonical id, scaled integer value, per-slot salt.
struct FieldLeaf {
  tag:       Uint<8>,
  field_key: Bytes<32>,
  value:     Uint<64>,
  salt:      Bytes<32>
}

// A provable bytes-valued field: `value_digest` is the blake2b-256 of the
// canonical value bytes.
struct BytesLeaf {
  tag:          Uint<8>,
  field_key:    Bytes<32>,
  value_digest: Bytes<32>,
  salt:         Bytes<32>
}

// An absent slot (no value, or padding beyond the field list). Salted like
// value leaves, so a shared leaf layer does not reveal WHICH fields exist.
struct AbsentLeaf {
  tag:       Uint<8>,
  field_key: Bytes<32>,
  salt:      Bytes<32>
}

struct MerkleNode {
  tag:   Uint<8>,
  left:  Bytes<32>,
  right: Bytes<32>
}

// One allowed value of a membership set.
struct SetLeaf {
  tag:          Uint<8>,
  value_digest: Bytes<32>
}

// Per-slot schema interpretation, shared by both documents of a comparison.
// `kind`: 0 = uint, 1 = bytes, 2 = padding. `scale` is the off-chain scaling
// of uint slots (0 otherwise): it never enters the value comparison (values
// arrive pre-scaled) but IS part of the schema root, so the same numbers
// under a different scaling are a DIFFERENT schema.
struct SlotDescriptor {
  tag:       Uint<8>,
  field_key: Bytes<32>,
  kind:      Uint<8>,
  scale:     Uint<64>
}

// One 32-byte seed per document derives one salt per slot.
struct SlotSalt {
  tag:   Uint<8>,
  seed:  Bytes<32>,
  index: Uint<8>
}

// One document's opening of one slot. The member not selected by the
// descriptor's kind is ignored.
struct SlotOpening {
  present:      Boolean,
  uint_value:   Uint<64>,
  value_digest: Bytes<32>
}

// Descriptor as witnessed: the tag is fixed in-circuit, not witnessed.
struct SlotSpec {
  field_key: Bytes<32>,
  kind:      Uint<8>,
  scale:     Uint<64>
}

// Claim identities. Every claim key embeds the record key(s), the anchored
// content root(s) and the schema at proving time, so a claim resolves only
// while that anchor stands.
struct FieldPredicateClaim {
  tag:          Uint<8>,
  record_key:   Bytes<32>,
  content_root: Bytes<32>,
  schema_id:    Bytes<32>,
  field_key:    Bytes<32>,
  threshold:    Uint<64>,
  op:           Uint<8>
}

struct FieldEqualityClaim {
  tag:          Uint<8>,
  record_key:   Bytes<32>,
  content_root: Bytes<32>,
  schema_id:    Bytes<32>,
  field_key:    Bytes<32>,
  expected:     Bytes<32>
}

struct FieldMembershipClaim {
  tag:          Uint<8>,
  record_key:   Bytes<32>,
  content_root: Bytes<32>,
  schema_id:    Bytes<32>,
  field_key:    Bytes<32>,
  set_root:     Bytes<32>
}

// The mask travels as a boolean vector (Compact has no bitwise ops). Bit i
// true = slot i MAY differ. (a, b) and (b, a) are distinct claims.
struct DocumentIntegrityClaim {
  tag:            Uint<8>,
  record_key_a:   Bytes<32>,
  content_root_a: Bytes<32>,
  record_key_b:   Bytes<32>,
  content_root_b: Bytes<32>,
  schema_id:      Bytes<32>,
  allowed_mask:   Vector<32, Boolean>
}

struct DocumentDiffClaim {
  tag:            Uint<8>,
  record_key_a:   Bytes<32>,
  content_root_a: Bytes<32>,
  record_key_b:   Bytes<32>,
  content_root_b: Bytes<32>,
  schema_id:      Bytes<32>,
  k:              Uint<8>
}

// Ledger key of an attestation: the attester's identity and the payload.
struct AttestRecordKey {
  tag:          Uint<8>,
  owner:        Bytes<32>,
  payload_hash: Bytes<32>
}

// ---- Witnesses ---------------------------------------------------------------

// Caller's secret, supplied off-chain. Hashed in-circuit into a stable
// attester_id without ever revealing the secret to the chain.
witness local_secret_key(): Bytes<32>;

// Field-bound inclusion proof. DEPTH is fixed at 5 (up to 32 provable
// fields); the off-chain builder pads to 2^5.
witness field_value():     Uint<64>;
witness field_salt():      Bytes<32>;
witness merkle_siblings(): Vector<5, Bytes<32>>;
witness merkle_dirs():     Vector<5, Boolean>;   // true => current node is the LEFT child

// Bytes-field proof material. `field_digest` is the blake2b-256 of the
// canonical value bytes (the hidden value for membership proofs). SET_DEPTH
// is fixed at 6 (up to 64 allowed values); the builder dedupes, sorts, pads.
witness field_digest():    Bytes<32>;
witness set_siblings():    Vector<6, Bytes<32>>;
witness set_dirs():        Vector<6, Boolean>;   // true => current node is the LEFT child

// Cross-root witnesses: ONE shared descriptor list plus each document's salt
// seed and full opening. The circuit recomputes schema and content roots from
// these and asserts them against the anchors.
witness doc_schema():  Vector<32, SlotSpec>;
witness doc_salt_a():  Bytes<32>;
witness doc_salt_b():  Bytes<32>;
witness doc_slots_a(): Vector<32, SlotOpening>;
witness doc_slots_b(): Vector<32, SlotOpening>;

// ---- Constants -------------------------------------------------------------

// Longest a claim may stay valid, in seconds (5 years).
pure circuit maxClaimLifetime(): Uint<64> {
  return 157680000;
}

// The caller's identity commitment. One-way, so publishing it on-chain does
// not leak the secret.
circuit caller_id(): Bytes<32> {
  return persistentHash<Bytes<32>>(local_secret_key());
}

// Both identities are PUBLIC constructor arguments: a witness-backed
// constructor makes the deploy proof heavy enough that, together with the
// verifier keys, the node rejects the deploy for exceeding the block limits.
// The deployer controls the values either way and may nominate a registrar
// other than the deploying session.
constructor(initial_registrar: Bytes<32>, initial_recovery: Bytes<32>) {
  registrar = disclose(initial_registrar);
  recovery = disclose(initial_recovery);
}

// ---- Tree hashing ----------------------------------------------------------
//
// All tree hashes are `transientHash` upgraded back to Bytes<32>, NOT
// `persistentHash`: persistentHash is in-circuit SHA-256 at ~2 MB of prover
// key PER INSTANCE. transientHash is not guaranteed stable across compiler
// generations: a compiler generation change means re-anchoring by the
// holders (who hold the data). Root computation must therefore always go
// through THIS artifact's exported pure circuits, never a re-implementation.
// Claim keys and commitments use persistentHash (they are stored identity).
export pure circuit leafHash(field_key: Bytes<32>, value: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<FieldLeaf>(FieldLeaf { tag: 1, field_key: field_key, value: value, salt: salt }));
}

export pure circuit bytesLeafHash(field_key: Bytes<32>, value_digest: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<BytesLeaf>(BytesLeaf { tag: 2, field_key: field_key, value_digest: value_digest, salt: salt }));
}

export pure circuit absentLeafHash(field_key: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<AbsentLeaf>(AbsentLeaf { tag: 3, field_key: field_key, salt: salt }));
}

export pure circuit nodeHash(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<MerkleNode>(MerkleNode { tag: 4, left: left, right: right }));
}

// Membership-set leaves are UNSALTED by design: the allow-list is public and
// every party must recompute the same set root from it.
export pure circuit setLeafHash(value_digest: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<SetLeaf>(SetLeaf { tag: 5, value_digest: value_digest }));
}

export pure circuit descriptorLeafHash(field_key: Bytes<32>, kind: Uint<8>, scale: Uint<64>): Bytes<32> {
  return upgradeFromTransient(transientHash<SlotDescriptor>(SlotDescriptor { tag: 6, field_key: field_key, kind: kind, scale: scale }));
}

export pure circuit slotSalt(seed: Bytes<32>, index: Uint<8>): Bytes<32> {
  return upgradeFromTransient(transientHash<SlotSalt>(SlotSalt { tag: 7, seed: seed, index: index }));
}

// Canonical padding-slot key: ASCII, zero-padded to 32 bytes (pad() right-
// pads). A literal digest is not expressible in Compact (out of Field range).
// The off-chain builder consumes THIS circuit.
export pure circuit emptyLeafKey(): Bytes<32> {
  return pad(32, "nightgate/empty-leaf/v2");
}

// The ledger key of an attester's record for a payload. Public and
// recomputable by anyone: off-chain verifiers and the proof circuits' callers
// take it from this circuit; the owner-gated circuits derive it from the
// caller's own identity.
export pure circuit recordKey(owner: Bytes<32>, payload_hash: Bytes<32>): Bytes<32> {
  return persistentHash<AttestRecordKey>(AttestRecordKey { tag: 21, owner: owner, payload_hash: payload_hash });
}

// Fold a 32-leaf layer to its depth-5 root. Unrolled; a statically-bounded
// `for` would expand to the identical circuit.
pure circuit fold32(
  l0: Bytes<32>, l1: Bytes<32>, l2: Bytes<32>, l3: Bytes<32>,
  l4: Bytes<32>, l5: Bytes<32>, l6: Bytes<32>, l7: Bytes<32>,
  l8: Bytes<32>, l9: Bytes<32>, l10: Bytes<32>, l11: Bytes<32>,
  l12: Bytes<32>, l13: Bytes<32>, l14: Bytes<32>, l15: Bytes<32>,
  l16: Bytes<32>, l17: Bytes<32>, l18: Bytes<32>, l19: Bytes<32>,
  l20: Bytes<32>, l21: Bytes<32>, l22: Bytes<32>, l23: Bytes<32>,
  l24: Bytes<32>, l25: Bytes<32>, l26: Bytes<32>, l27: Bytes<32>,
  l28: Bytes<32>, l29: Bytes<32>, l30: Bytes<32>, l31: Bytes<32>
): Bytes<32> {
  const a0 = nodeHash(l0, l1);
  const a1 = nodeHash(l2, l3);
  const a2 = nodeHash(l4, l5);
  const a3 = nodeHash(l6, l7);
  const a4 = nodeHash(l8, l9);
  const a5 = nodeHash(l10, l11);
  const a6 = nodeHash(l12, l13);
  const a7 = nodeHash(l14, l15);
  const a8 = nodeHash(l16, l17);
  const a9 = nodeHash(l18, l19);
  const a10 = nodeHash(l20, l21);
  const a11 = nodeHash(l22, l23);
  const a12 = nodeHash(l24, l25);
  const a13 = nodeHash(l26, l27);
  const a14 = nodeHash(l28, l29);
  const a15 = nodeHash(l30, l31);
  const b0 = nodeHash(a0, a1);
  const b1 = nodeHash(a2, a3);
  const b2 = nodeHash(a4, a5);
  const b3 = nodeHash(a6, a7);
  const b4 = nodeHash(a8, a9);
  const b5 = nodeHash(a10, a11);
  const b6 = nodeHash(a12, a13);
  const b7 = nodeHash(a14, a15);
  const c0 = nodeHash(b0, b1);
  const c1 = nodeHash(b2, b3);
  const c2 = nodeHash(b4, b5);
  const c3 = nodeHash(b6, b7);
  return nodeHash(nodeHash(c0, c1), nodeHash(c2, c3));
}

// One slot's leaf. Padding slots and absent fields land on the salted absent
// leaf; the unused opening members are ignored.
pure circuit slotLeaf(d: SlotSpec, o: SlotOpening, salt: Bytes<32>): Bytes<32> {
  if (d.kind == 0 && o.present) {
    return leafHash(d.field_key, o.uint_value, salt);
  }
  if (d.kind == 1 && o.present) {
    return bytesLeafHash(d.field_key, o.value_digest, salt);
  }
  return absentLeafHash(d.field_key, salt);
}

// Per-slot difference on VALUE level: leaf hashes cannot be compared across
// documents, their salts differ. Padding never differs; both-absent is no
// difference; present-vs-absent IS one; both-present compares the kind's
// value member.
pure circuit slotDiff(d: SlotSpec, a: SlotOpening, b: SlotOpening): Uint<8> {
  if (d.kind == 2) {
    return 0;
  }
  if (!a.present && !b.present) {
    return 0;
  }
  if ((a.present && !b.present) || (!a.present && b.present)) {
    return 1;
  }
  if (d.kind == 0) {
    if (a.uint_value == b.uint_value) {
      return 0;
    }
    return 1;
  }
  if (a.value_digest == b.value_digest) {
    return 0;
  }
  return 1;
}

// Descriptors are WITNESS data, so their shape is pinned before any root
// math: an out-of-range kind would land on the absent leaf in slotLeaf but
// compare as a bytes field in slotDiff. The canonical shape (no scale on
// non-uint slots, the padding key only on padding slots, absence on padding)
// gives one field list exactly one descriptor encoding.
pure circuit assertCanonicalSlot(d: SlotSpec, a: SlotOpening, b: SlotOpening): [] {
  assert(d.kind <= 2, "schema kind out of range");
  if (d.kind == 2) {
    assert(d.field_key == emptyLeafKey(), "padding slot key must be canonical");
    assert(!a.present && !b.present, "padding slot must be absent");
  } else {
    assert(!(d.field_key == emptyLeafKey()), "padding key in a real slot");
  }
  if (!(d.kind == 0)) {
    assert(d.scale == 0, "schema scale must be 0 for non-uint slots");
  }
}

// True when the mask actually CONSTRAINS this slot: a real (non-padding) slot
// the mask does not free. An integrity claim whose mask frees every real slot
// says nothing, so at least one constrained slot is required in-circuit.
pure circuit constrainsSlot(allowed: Boolean, d: SlotSpec): Boolean {
  return !allowed && !(d.kind == 2);
}

pure circuit assertUnchanged(allowed: Boolean, d: SlotSpec, a: SlotOpening, b: SlotOpening): [] {
  if (!allowed) {
    assert(slotDiff(d, a, b) == 0, "slot changed outside allowed mask");
  }
}

// Schema root over a witnessed descriptor list, and a document's content root
// over that schema, its opening and its salt seed. Both are recomputed
// in-circuit and asserted against the anchors, which is what makes an
// anchored schema id PROVEN rather than claimed.
pure circuit schemaRootOf(ds: Vector<32, SlotSpec>): Bytes<32> {
  return fold32(
    descriptorLeafHash(ds[0].field_key, ds[0].kind, ds[0].scale),
    descriptorLeafHash(ds[1].field_key, ds[1].kind, ds[1].scale),
    descriptorLeafHash(ds[2].field_key, ds[2].kind, ds[2].scale),
    descriptorLeafHash(ds[3].field_key, ds[3].kind, ds[3].scale),
    descriptorLeafHash(ds[4].field_key, ds[4].kind, ds[4].scale),
    descriptorLeafHash(ds[5].field_key, ds[5].kind, ds[5].scale),
    descriptorLeafHash(ds[6].field_key, ds[6].kind, ds[6].scale),
    descriptorLeafHash(ds[7].field_key, ds[7].kind, ds[7].scale),
    descriptorLeafHash(ds[8].field_key, ds[8].kind, ds[8].scale),
    descriptorLeafHash(ds[9].field_key, ds[9].kind, ds[9].scale),
    descriptorLeafHash(ds[10].field_key, ds[10].kind, ds[10].scale),
    descriptorLeafHash(ds[11].field_key, ds[11].kind, ds[11].scale),
    descriptorLeafHash(ds[12].field_key, ds[12].kind, ds[12].scale),
    descriptorLeafHash(ds[13].field_key, ds[13].kind, ds[13].scale),
    descriptorLeafHash(ds[14].field_key, ds[14].kind, ds[14].scale),
    descriptorLeafHash(ds[15].field_key, ds[15].kind, ds[15].scale),
    descriptorLeafHash(ds[16].field_key, ds[16].kind, ds[16].scale),
    descriptorLeafHash(ds[17].field_key, ds[17].kind, ds[17].scale),
    descriptorLeafHash(ds[18].field_key, ds[18].kind, ds[18].scale),
    descriptorLeafHash(ds[19].field_key, ds[19].kind, ds[19].scale),
    descriptorLeafHash(ds[20].field_key, ds[20].kind, ds[20].scale),
    descriptorLeafHash(ds[21].field_key, ds[21].kind, ds[21].scale),
    descriptorLeafHash(ds[22].field_key, ds[22].kind, ds[22].scale),
    descriptorLeafHash(ds[23].field_key, ds[23].kind, ds[23].scale),
    descriptorLeafHash(ds[24].field_key, ds[24].kind, ds[24].scale),
    descriptorLeafHash(ds[25].field_key, ds[25].kind, ds[25].scale),
    descriptorLeafHash(ds[26].field_key, ds[26].kind, ds[26].scale),
    descriptorLeafHash(ds[27].field_key, ds[27].kind, ds[27].scale),
    descriptorLeafHash(ds[28].field_key, ds[28].kind, ds[28].scale),
    descriptorLeafHash(ds[29].field_key, ds[29].kind, ds[29].scale),
    descriptorLeafHash(ds[30].field_key, ds[30].kind, ds[30].scale),
    descriptorLeafHash(ds[31].field_key, ds[31].kind, ds[31].scale)
  );
}

pure circuit contentRootOf(
  ds:   Vector<32, SlotSpec>,
  os:   Vector<32, SlotOpening>,
  seed: Bytes<32>
): Bytes<32> {
  return fold32(
    slotLeaf(ds[0], os[0], slotSalt(seed, 0)),
    slotLeaf(ds[1], os[1], slotSalt(seed, 1)),
    slotLeaf(ds[2], os[2], slotSalt(seed, 2)),
    slotLeaf(ds[3], os[3], slotSalt(seed, 3)),
    slotLeaf(ds[4], os[4], slotSalt(seed, 4)),
    slotLeaf(ds[5], os[5], slotSalt(seed, 5)),
    slotLeaf(ds[6], os[6], slotSalt(seed, 6)),
    slotLeaf(ds[7], os[7], slotSalt(seed, 7)),
    slotLeaf(ds[8], os[8], slotSalt(seed, 8)),
    slotLeaf(ds[9], os[9], slotSalt(seed, 9)),
    slotLeaf(ds[10], os[10], slotSalt(seed, 10)),
    slotLeaf(ds[11], os[11], slotSalt(seed, 11)),
    slotLeaf(ds[12], os[12], slotSalt(seed, 12)),
    slotLeaf(ds[13], os[13], slotSalt(seed, 13)),
    slotLeaf(ds[14], os[14], slotSalt(seed, 14)),
    slotLeaf(ds[15], os[15], slotSalt(seed, 15)),
    slotLeaf(ds[16], os[16], slotSalt(seed, 16)),
    slotLeaf(ds[17], os[17], slotSalt(seed, 17)),
    slotLeaf(ds[18], os[18], slotSalt(seed, 18)),
    slotLeaf(ds[19], os[19], slotSalt(seed, 19)),
    slotLeaf(ds[20], os[20], slotSalt(seed, 20)),
    slotLeaf(ds[21], os[21], slotSalt(seed, 21)),
    slotLeaf(ds[22], os[22], slotSalt(seed, 22)),
    slotLeaf(ds[23], os[23], slotSalt(seed, 23)),
    slotLeaf(ds[24], os[24], slotSalt(seed, 24)),
    slotLeaf(ds[25], os[25], slotSalt(seed, 25)),
    slotLeaf(ds[26], os[26], slotSalt(seed, 26)),
    slotLeaf(ds[27], os[27], slotSalt(seed, 27)),
    slotLeaf(ds[28], os[28], slotSalt(seed, 28)),
    slotLeaf(ds[29], os[29], slotSalt(seed, 29)),
    slotLeaf(ds[30], os[30], slotSalt(seed, 30)),
    slotLeaf(ds[31], os[31], slotSalt(seed, 31))
  );
}

circuit merkleStep(node: Bytes<32>, sibling: Bytes<32>, goesLeft: Boolean): Bytes<32> {
  if (goesLeft) {
    return nodeHash(node, sibling);
  }
  return nodeHash(sibling, node);
}

// ---- Attestation lifecycle -------------------------------------------------

// The caller's own record key for a payload: every owner-gated circuit works
// on this key, so a caller can only ever touch records of its own identity.
circuit ownRecord(payload_hash: Bytes<32>): Bytes<32> {
  return recordKey(caller_id(), payload_hash);
}

circuit ownAttestedRecord(payload_hash: Bytes<32>): Bytes<32> {
  const key = ownRecord(payload_hash);
  assert(attestations.member(disclose(key)), "no attestation");
  return key;
}

circuit anchorOf(record_key: Bytes<32>): ContentAnchor {
  assert(content_anchors.member(disclose(record_key)), "no content root");
  return content_anchors.lookup(disclose(record_key));
}

// Removes the id -> record binding recorded for this attestation, if any.
circuit unbindDocument(record_key: Bytes<32>): [] {
  const rec = attestations.lookup(disclose(record_key));
  if (!(rec.document_id == pad(32, ""))) {
    if (document_bindings.member(rec.document_id)) {
      if (document_bindings.lookup(rec.document_id) == disclose(record_key)) {
        document_bindings.remove(rec.document_id);
      }
    }
  }
}

// Removes everything recorded under a record except its attestation entry.
circuit clearRecord(record_key: Bytes<32>): [] {
  unbindDocument(record_key);
  if (content_anchors.member(disclose(record_key))) {
    content_anchors.remove(disclose(record_key));
  }
  if (disclosures.member(disclose(record_key))) {
    disclosures.remove(disclose(record_key));
  }
}

// A block-time claim `valid_until` must lie in the future and at most the
// lifetime cap ahead: the transaction is only valid in a block whose time lies
// in (valid_until - cap, valid_until). The kernel comparisons RETURN a boolean
// (they do not assert); the recorded result is what the ledger re-checks at
// application.
circuit assertLifetime(valid_until: Uint<64>, cap: Uint<64>): [] {
  assert(kernel.blockTimeLessThan(disclose(valid_until)), "expiry must lie in the future");
  if (disclose(valid_until > cap)) {
    assert(kernel.blockTimeGreaterThan(disclose((valid_until - cap) as Uint<64>)), "expiry too far ahead");
  }
}

// A claim's expiry may only be kept or extended by a later proof: the proof
// circuits are open to any holder of the opening, and a shortened expiry
// would let such a holder expire and purge the attester's claim.
circuit recordClaim(key: Bytes<32>, valid_until: Uint<64>): [] {
  if (claims.member(disclose(key))) {
    assert(claims.lookup(disclose(key)) <= valid_until, "claim expiry cannot be shortened");
  }
  claims.insert(disclose(key), disclose(valid_until));
}

// Records the caller's attestation of a payload. The record key carries the
// caller's identity, so the same payload attested by another identity is a
// different record: nobody can pre-empt or take over this one. Insert-once
// per record; a different metadata needs a retract first.
export circuit attest(payload_hash: Bytes<32>, metadata_hash: Bytes<32>): [] {
  const key = ownRecord(payload_hash);
  assert(!attestations.member(disclose(key)), "already attested");
  attestations.insert(disclose(key), Attestation {
    payload_hash:  disclose(payload_hash),
    metadata_hash: disclose(metadata_hash),
    owner:         disclose(caller_id()),
    document_id:   pad(32, "")
  });
}

// Removal. Mode 0: the owner retracts a payload (`key` = payload_hash;
// attestation, anchor, disclosures, document binding). Mode 1: anyone removes
// an expired claim (`key` = claim key).
export circuit retract(mode: Uint<8>, key: Bytes<32>): [] {
  const m = disclose(mode);
  assert(m <= 1, "mode out of range");
  if (m == 0) {
    const record = ownAttestedRecord(key);
    clearRecord(record);
    attestations.remove(disclose(record));
    return;
  }
  assert(claims.member(disclose(key)), "no claim");
  assert(kernel.blockTimeGreaterThan(claims.lookup(disclose(key))), "claim not expired");
  claims.remove(disclose(key));
}

export circuit grantDisclosure(
  payload_hash: Bytes<32>,
  grantee:      Bytes<32>,
  level:        Uint<8>
): [] {
  const key = ownAttestedRecord(payload_hash);
  // In-circuit, not just server-side: direct callers must not record levels
  // outside the documented 0..2 tier model.
  assert(level <= 2, "level out of range");
  if (!disclosures.member(disclose(key))) {
    disclosures.insert(disclose(key), default<Map<Bytes<32>, Uint<8>>>);
  }
  disclosures.lookup(disclose(key)).insert(disclose(grantee), disclose(level));
}

export circuit revokeDisclosure(payload_hash: Bytes<32>, grantee: Bytes<32>): [] {
  const key = ownAttestedRecord(payload_hash);
  assert(disclosures.member(disclose(key)), "no disclosures");
  disclosures.lookup(disclose(key)).remove(disclose(grantee));
}

// A re-assigned id must not keep resolving to a record the new owner does
// not hold, so a binding by another attester is released with the
// registration.
circuit releaseForeignBinding(document_id: Bytes<32>, owner_id: Bytes<32>): [] {
  if (document_bindings.member(disclose(document_id))) {
    const previous = document_bindings.lookup(disclose(document_id));
    const old = attestations.lookup(previous);
    if (!(old.owner == disclose(owner_id))) {
      attestations.insert(previous, Attestation {
        payload_hash:  old.payload_hash,
        metadata_hash: old.metadata_hash,
        owner:         old.owner,
        document_id:   pad(32, "")
      });
      document_bindings.remove(disclose(document_id));
    }
  }
}

// Modes 0-2 are registrar-only. Mode 0: assign (or re-assign) a document_id
// to an attester; overwrite is the ownership-transfer and squatter-recovery
// path (the registrar re-points the id and any binding by another attester
// is released; the new owner binds). Mode 1: unregister the id (`owner_id`
// zero). Mode 2: transfer the registrar role to `owner_id` (`document_id`
// zero). Modes 3-4 are recovery-only (`document_id` zero): 3 re-points the
// registrar to `owner_id`, 4 hands the recovery role to `owner_id`.
export circuit registerDocument(mode: Uint<8>, document_id: Bytes<32>, owner_id: Bytes<32>): [] {
  const m = disclose(mode);
  assert(m <= 4, "mode out of range");
  const zero = pad(32, "");
  if (m >= 3) {
    assert(caller_id() == recovery, "not recovery");
    assert(document_id == zero, "id must be the neutral dummy in recovery mode");
    assert(!(owner_id == zero), "identity must not be zero");
    if (m == 3) {
      registrar = disclose(owner_id);
    } else {
      recovery = disclose(owner_id);
    }
    return;
  }
  assert(caller_id() == registrar, "not registrar");
  if (m == 0) {
    releaseForeignBinding(document_id, owner_id);
    document_owners.insert(disclose(document_id), disclose(owner_id));
    return;
  }
  if (m == 1) {
    assert(owner_id == zero, "owner must be the neutral dummy in unregister mode");
    assert(document_owners.member(disclose(document_id)), "id not registered");
    document_owners.remove(disclose(document_id));
    return;
  }
  assert(document_id == zero, "id must be the neutral dummy in transfer mode");
  assert(!(owner_id == zero), "registrar must not be zero");
  registrar = disclose(owner_id);
}

// Bind a document_id to the caller's own attestation, so an external document
// identifier resolves on-chain. Authority over the id itself is two-tier:
//   1. REGISTERED ids: only the registered attester may bind or re-bind,
//      regardless of an existing binding.
//   2. UNREGISTERED ids: first-come-first-served, and an existing binding may
//      only be re-bound by the owner of its currently bound record.
// The pairing is one-to-one: a rebind clears the id's previous record and
// the record's previous id.
export circuit bindDocument(document_id: Bytes<32>, payload_hash: Bytes<32>): [] {
  const key = ownAttestedRecord(payload_hash);
  assert(!(document_id == pad(32, "")), "document id must not be zero");
  if (document_owners.member(disclose(document_id))) {
    assert(document_owners.lookup(disclose(document_id)) == caller_id(), "not document owner");
  } else {
    if (document_bindings.member(disclose(document_id))) {
      assert(attestations.lookup(document_bindings.lookup(disclose(document_id))).owner == caller_id(),
             "document bound by another attester");
    }
  }
  if (document_bindings.member(disclose(document_id))) {
    const previous = document_bindings.lookup(disclose(document_id));
    if (!(previous == disclose(key))) {
      const old = attestations.lookup(previous);
      attestations.insert(previous, Attestation {
        payload_hash:  old.payload_hash,
        metadata_hash: old.metadata_hash,
        owner:         old.owner,
        document_id:   pad(32, "")
      });
    }
  }
  unbindDocument(key);
  const rec = attestations.lookup(disclose(key));
  attestations.insert(disclose(key), Attestation {
    payload_hash:  rec.payload_hash,
    metadata_hash: rec.metadata_hash,
    owner:         rec.owner,
    document_id:   disclose(document_id)
  });
  document_bindings.insert(disclose(document_id), disclose(key));
}

// The attester anchors the Merkle root over the document's provable fields
// plus the schema id of the ordered field list it was built over, computed
// off-chain from the SAME canonical content that produced payload_hash.
//
// INSERT-ONCE-OR-IDENTICAL: a payload_hash names immutable content, so its
// root and schema are immutable too. Re-anchoring the identical pair stays
// allowed, so retries are idempotent. A different root needs a retract and a
// fresh attestation.
export circuit anchorContentRoot(
  payload_hash: Bytes<32>,
  content_root: Bytes<32>,
  schema_id:    Bytes<32>
): [] {
  const key = ownAttestedRecord(payload_hash);
  if (content_anchors.member(disclose(key))) {
    const anchor = content_anchors.lookup(disclose(key));
    assert(anchor.root == disclose(content_root), "content root already anchored");
    assert(anchor.schema == disclose(schema_id), "schema already anchored");
  } else {
    content_anchors.insert(disclose(key), ContentAnchor {
      root:   disclose(content_root),
      schema: disclose(schema_id)
    });
  }
}

// ---- Proofs ------------------------------------------------------------------

// Fold the witnessed depth-5 inclusion path from a leaf to the root.
circuit fieldRoot(leaf: Bytes<32>): Bytes<32> {
  const sibs = merkle_siblings();
  const dirs = merkle_dirs();
  const n1 = merkleStep(leaf, sibs[0], dirs[0]);
  const n2 = merkleStep(n1, sibs[1], dirs[1]);
  const n3 = merkleStep(n2, sibs[2], dirs[2]);
  const n4 = merkleStep(n3, sibs[3], dirs[3]);
  return merkleStep(n4, sibs[4], dirs[4]);
}

// Prove a field satisfies a predicate against a public threshold without
// revealing the value, bound to the anchored content root so the value
// provably belongs to THIS document: recompute the leaf, fold the witnessed
// inclusion path, assert it equals the anchored root, then check the
// predicate. `op`: 0 = lessOrEqual, 1 = greaterOrEqual.
export circuit proveFieldPredicate(
  record_key: Bytes<32>,
  field_key:    Bytes<32>,
  threshold:    Uint<64>,
  op:           Uint<8>,
  valid_until:  Uint<64>
): [] {
  const anchor = anchorOf(record_key);
  // In-circuit, not just server-side: any other op would silently select the
  // greaterOrEqual branch for direct callers.
  assert(op <= 1, "op out of range");
  assertLifetime(valid_until, maxClaimLifetime());
  const v = field_value();
  assert(fieldRoot(leafHash(field_key, v, field_salt())) == anchor.root, "field not in document");
  if (op == 0) {
    assert(v <= threshold, "predicate false");
  } else {
    assert(v >= threshold, "predicate false");
  }
  const claimKey = persistentHash<FieldPredicateClaim>(FieldPredicateClaim {
    tag:          16,
    record_key: record_key,
    content_root: anchor.root,
    schema_id:    anchor.schema,
    field_key:    field_key,
    threshold:    threshold,
    op:           op
  });
  recordClaim(claimKey, valid_until);
}

// Prove a bytes-valued field carries exactly the value whose canonical digest
// is `expected_digest`. The digest is PUBLIC (it is the statement), so no
// value witness is needed. The salt is witnessed, so the public digest alone
// does not determine the leaf: only a holder of the slot's salt can run this.
// Authenticity, not confidentiality: a low-entropy value's digest is
// dictionary-guessable.
export circuit proveFieldEquality(
  record_key:    Bytes<32>,
  field_key:       Bytes<32>,
  expected_digest: Bytes<32>,
  valid_until:     Uint<64>
): [] {
  const anchor = anchorOf(record_key);
  assertLifetime(valid_until, maxClaimLifetime());
  assert(fieldRoot(bytesLeafHash(field_key, expected_digest, field_salt())) == anchor.root, "field not in document");
  const claimKey = persistentHash<FieldEqualityClaim>(FieldEqualityClaim {
    tag:          17,
    record_key: record_key,
    content_root: anchor.root,
    schema_id:    anchor.schema,
    field_key:    field_key,
    expected:     expected_digest
  });
  recordClaim(claimKey, valid_until);
}

// Prove a bytes-valued field's HIDDEN value is one of a public allow-list,
// without revealing which. Two folds over the same witnessed digest: the
// content fold binds it to `field_key` of THIS document's anchored root, the
// set fold proves it is a leaf of the public set tree (canonical off-chain
// rule: digest, dedupe, sort ascending, pad). The digest travels only as a
// witness.
export circuit proveFieldMembership(
  record_key: Bytes<32>,
  field_key:    Bytes<32>,
  set_root:     Bytes<32>,
  valid_until:  Uint<64>
): [] {
  const anchor = anchorOf(record_key);
  assertLifetime(valid_until, maxClaimLifetime());
  const d = field_digest();
  assert(fieldRoot(bytesLeafHash(field_key, d, field_salt())) == anchor.root, "field not in document");
  const ssibs = set_siblings();
  const sdirs = set_dirs();
  const s0 = setLeafHash(d);
  const s1 = merkleStep(s0, ssibs[0], sdirs[0]);
  const s2 = merkleStep(s1, ssibs[1], sdirs[1]);
  const s3 = merkleStep(s2, ssibs[2], sdirs[2]);
  const s4 = merkleStep(s3, ssibs[3], sdirs[3]);
  const s5 = merkleStep(s4, ssibs[4], sdirs[4]);
  const sroot = merkleStep(s5, ssibs[5], sdirs[5]);
  assert(sroot == set_root, "value not in set");
  const claimKey = persistentHash<FieldMembershipClaim>(FieldMembershipClaim {
    tag:          18,
    record_key: record_key,
    content_root: anchor.root,
    schema_id:    anchor.schema,
    field_key:    field_key,
    set_root:     set_root
  });
  recordClaim(claimKey, valid_until);
}

// ONE mode-switched circuit for both cross-root claims. `mode` 0 proves B
// differs from A ONLY in the slots flagged by `allowed_mask` (`k` rides as
// the neutral dummy 1); `mode` 1 proves at least `k` of the 32 aligned slots
// differ (`allowed_mask` rides as all-false). Values stay hidden in both.
//
// Both modes share one witness layer and one root-recompute pass per
// document, executed before the mode branch. The schema root is recomputed
// from the SHARED descriptor list and asserted against BOTH anchors, so
// schema parity is structural AND the anchored schema id is proven to
// describe the trees. A counted or blocked difference is a value change or a
// field that appeared or disappeared; empty-vs-empty compares equal.
export circuit proveDocumentComparison(
  record_key_a: Bytes<32>,
  record_key_b: Bytes<32>,
  mode:           Uint<8>,
  allowed_mask:   Vector<32, Boolean>,
  k:              Uint<8>,
  valid_until:    Uint<64>
): [] {
  // The mode selects which claim is written, so disclose it before branching.
  const m = disclose(mode);
  assert(m <= 1, "mode out of range");
  // The inactive mode's argument must ride as its fixed neutral dummy, so a
  // transaction's public args never suggest a statement the circuit did not
  // check. Neither dummy enters its mode's claim key.
  if (m == 0) {
    assert(k == 1, "k must be the neutral dummy in integrity mode");
  } else {
    assert(!(allowed_mask[0] || allowed_mask[1] || allowed_mask[2] || allowed_mask[3]
          || allowed_mask[4] || allowed_mask[5] || allowed_mask[6] || allowed_mask[7]
          || allowed_mask[8] || allowed_mask[9] || allowed_mask[10] || allowed_mask[11]
          || allowed_mask[12] || allowed_mask[13] || allowed_mask[14] || allowed_mask[15]
          || allowed_mask[16] || allowed_mask[17] || allowed_mask[18] || allowed_mask[19]
          || allowed_mask[20] || allowed_mask[21] || allowed_mask[22] || allowed_mask[23]
          || allowed_mask[24] || allowed_mask[25] || allowed_mask[26] || allowed_mask[27]
          || allowed_mask[28] || allowed_mask[29] || allowed_mask[30] || allowed_mask[31]),
           "mask must be the neutral dummy in diff mode");
  }
  // In-circuit, not just server-side: no trivially-true claim of a document
  // against itself.
  assert(!(record_key_a == record_key_b), "records must differ");
  assert(content_anchors.member(disclose(record_key_a)), "no content root A");
  assert(content_anchors.member(disclose(record_key_b)), "no content root B");
  assertLifetime(valid_until, maxClaimLifetime());
  const anchorA = content_anchors.lookup(disclose(record_key_a));
  const anchorB = content_anchors.lookup(disclose(record_key_b));
  const ds = doc_schema();
  const oa = doc_slots_a();
  const ob = doc_slots_b();
  // Canonical-schema guard BEFORE any root math (see assertCanonicalSlot).
  assertCanonicalSlot(ds[0], oa[0], ob[0]);
  assertCanonicalSlot(ds[1], oa[1], ob[1]);
  assertCanonicalSlot(ds[2], oa[2], ob[2]);
  assertCanonicalSlot(ds[3], oa[3], ob[3]);
  assertCanonicalSlot(ds[4], oa[4], ob[4]);
  assertCanonicalSlot(ds[5], oa[5], ob[5]);
  assertCanonicalSlot(ds[6], oa[6], ob[6]);
  assertCanonicalSlot(ds[7], oa[7], ob[7]);
  assertCanonicalSlot(ds[8], oa[8], ob[8]);
  assertCanonicalSlot(ds[9], oa[9], ob[9]);
  assertCanonicalSlot(ds[10], oa[10], ob[10]);
  assertCanonicalSlot(ds[11], oa[11], ob[11]);
  assertCanonicalSlot(ds[12], oa[12], ob[12]);
  assertCanonicalSlot(ds[13], oa[13], ob[13]);
  assertCanonicalSlot(ds[14], oa[14], ob[14]);
  assertCanonicalSlot(ds[15], oa[15], ob[15]);
  assertCanonicalSlot(ds[16], oa[16], ob[16]);
  assertCanonicalSlot(ds[17], oa[17], ob[17]);
  assertCanonicalSlot(ds[18], oa[18], ob[18]);
  assertCanonicalSlot(ds[19], oa[19], ob[19]);
  assertCanonicalSlot(ds[20], oa[20], ob[20]);
  assertCanonicalSlot(ds[21], oa[21], ob[21]);
  assertCanonicalSlot(ds[22], oa[22], ob[22]);
  assertCanonicalSlot(ds[23], oa[23], ob[23]);
  assertCanonicalSlot(ds[24], oa[24], ob[24]);
  assertCanonicalSlot(ds[25], oa[25], ob[25]);
  assertCanonicalSlot(ds[26], oa[26], ob[26]);
  assertCanonicalSlot(ds[27], oa[27], ob[27]);
  assertCanonicalSlot(ds[28], oa[28], ob[28]);
  assertCanonicalSlot(ds[29], oa[29], ob[29]);
  assertCanonicalSlot(ds[30], oa[30], ob[30]);
  assertCanonicalSlot(ds[31], oa[31], ob[31]);
  // ONE witnessed descriptor list must fold to BOTH anchored schema ids:
  // parity is structural, and a mislabeled anchor fails here because the real
  // descriptors cannot fold to it.
  const schemaRoot = schemaRootOf(ds);
  assert(schemaRoot == anchorA.schema, "doc A schema mismatch");
  assert(schemaRoot == anchorB.schema, "doc B schema mismatch");
  // Each document's witnessed opening and salt seed must recompute its
  // anchored root under the shared schema.
  assert(contentRootOf(ds, oa, doc_salt_a()) == anchorA.root, "doc A opening does not match anchored root");
  assert(contentRootOf(ds, ob, doc_salt_b()) == anchorB.root, "doc B opening does not match anchored root");
  if (m == 0) {
    // Non-vacuity (see constrainsSlot): at least one real schema slot must
    // stay constrained. Subsumes the all-ones mask and masks that free every
    // non-padding slot of a shorter schema.
    assert(constrainsSlot(allowed_mask[0], ds[0])
        || constrainsSlot(allowed_mask[1], ds[1])
        || constrainsSlot(allowed_mask[2], ds[2])
        || constrainsSlot(allowed_mask[3], ds[3])
        || constrainsSlot(allowed_mask[4], ds[4])
        || constrainsSlot(allowed_mask[5], ds[5])
        || constrainsSlot(allowed_mask[6], ds[6])
        || constrainsSlot(allowed_mask[7], ds[7])
        || constrainsSlot(allowed_mask[8], ds[8])
        || constrainsSlot(allowed_mask[9], ds[9])
        || constrainsSlot(allowed_mask[10], ds[10])
        || constrainsSlot(allowed_mask[11], ds[11])
        || constrainsSlot(allowed_mask[12], ds[12])
        || constrainsSlot(allowed_mask[13], ds[13])
        || constrainsSlot(allowed_mask[14], ds[14])
        || constrainsSlot(allowed_mask[15], ds[15])
        || constrainsSlot(allowed_mask[16], ds[16])
        || constrainsSlot(allowed_mask[17], ds[17])
        || constrainsSlot(allowed_mask[18], ds[18])
        || constrainsSlot(allowed_mask[19], ds[19])
        || constrainsSlot(allowed_mask[20], ds[20])
        || constrainsSlot(allowed_mask[21], ds[21])
        || constrainsSlot(allowed_mask[22], ds[22])
        || constrainsSlot(allowed_mask[23], ds[23])
        || constrainsSlot(allowed_mask[24], ds[24])
        || constrainsSlot(allowed_mask[25], ds[25])
        || constrainsSlot(allowed_mask[26], ds[26])
        || constrainsSlot(allowed_mask[27], ds[27])
        || constrainsSlot(allowed_mask[28], ds[28])
        || constrainsSlot(allowed_mask[29], ds[29])
        || constrainsSlot(allowed_mask[30], ds[30])
        || constrainsSlot(allowed_mask[31], ds[31]),
           "mask must constrain at least one schema slot");
    assertUnchanged(allowed_mask[0], ds[0], oa[0], ob[0]);
    assertUnchanged(allowed_mask[1], ds[1], oa[1], ob[1]);
    assertUnchanged(allowed_mask[2], ds[2], oa[2], ob[2]);
    assertUnchanged(allowed_mask[3], ds[3], oa[3], ob[3]);
    assertUnchanged(allowed_mask[4], ds[4], oa[4], ob[4]);
    assertUnchanged(allowed_mask[5], ds[5], oa[5], ob[5]);
    assertUnchanged(allowed_mask[6], ds[6], oa[6], ob[6]);
    assertUnchanged(allowed_mask[7], ds[7], oa[7], ob[7]);
    assertUnchanged(allowed_mask[8], ds[8], oa[8], ob[8]);
    assertUnchanged(allowed_mask[9], ds[9], oa[9], ob[9]);
    assertUnchanged(allowed_mask[10], ds[10], oa[10], ob[10]);
    assertUnchanged(allowed_mask[11], ds[11], oa[11], ob[11]);
    assertUnchanged(allowed_mask[12], ds[12], oa[12], ob[12]);
    assertUnchanged(allowed_mask[13], ds[13], oa[13], ob[13]);
    assertUnchanged(allowed_mask[14], ds[14], oa[14], ob[14]);
    assertUnchanged(allowed_mask[15], ds[15], oa[15], ob[15]);
    assertUnchanged(allowed_mask[16], ds[16], oa[16], ob[16]);
    assertUnchanged(allowed_mask[17], ds[17], oa[17], ob[17]);
    assertUnchanged(allowed_mask[18], ds[18], oa[18], ob[18]);
    assertUnchanged(allowed_mask[19], ds[19], oa[19], ob[19]);
    assertUnchanged(allowed_mask[20], ds[20], oa[20], ob[20]);
    assertUnchanged(allowed_mask[21], ds[21], oa[21], ob[21]);
    assertUnchanged(allowed_mask[22], ds[22], oa[22], ob[22]);
    assertUnchanged(allowed_mask[23], ds[23], oa[23], ob[23]);
    assertUnchanged(allowed_mask[24], ds[24], oa[24], ob[24]);
    assertUnchanged(allowed_mask[25], ds[25], oa[25], ob[25]);
    assertUnchanged(allowed_mask[26], ds[26], oa[26], ob[26]);
    assertUnchanged(allowed_mask[27], ds[27], oa[27], ob[27]);
    assertUnchanged(allowed_mask[28], ds[28], oa[28], ob[28]);
    assertUnchanged(allowed_mask[29], ds[29], oa[29], ob[29]);
    assertUnchanged(allowed_mask[30], ds[30], oa[30], ob[30]);
    assertUnchanged(allowed_mask[31], ds[31], oa[31], ob[31]);
    const integrityKey = persistentHash<DocumentIntegrityClaim>(DocumentIntegrityClaim {
      tag:            19,
      record_key_a: record_key_a,
      content_root_a: anchorA.root,
      record_key_b: record_key_b,
      content_root_b: anchorB.root,
      schema_id:      schemaRoot,
      allowed_mask:   allowed_mask
    });
    recordClaim(integrityKey, valid_until);
    return;
  }
  assert(k >= 1 && k <= 32, "k out of range");
  const count = slotDiff(ds[0], oa[0], ob[0])
              + slotDiff(ds[1], oa[1], ob[1])
              + slotDiff(ds[2], oa[2], ob[2])
              + slotDiff(ds[3], oa[3], ob[3])
              + slotDiff(ds[4], oa[4], ob[4])
              + slotDiff(ds[5], oa[5], ob[5])
              + slotDiff(ds[6], oa[6], ob[6])
              + slotDiff(ds[7], oa[7], ob[7])
              + slotDiff(ds[8], oa[8], ob[8])
              + slotDiff(ds[9], oa[9], ob[9])
              + slotDiff(ds[10], oa[10], ob[10])
              + slotDiff(ds[11], oa[11], ob[11])
              + slotDiff(ds[12], oa[12], ob[12])
              + slotDiff(ds[13], oa[13], ob[13])
              + slotDiff(ds[14], oa[14], ob[14])
              + slotDiff(ds[15], oa[15], ob[15])
              + slotDiff(ds[16], oa[16], ob[16])
              + slotDiff(ds[17], oa[17], ob[17])
              + slotDiff(ds[18], oa[18], ob[18])
              + slotDiff(ds[19], oa[19], ob[19])
              + slotDiff(ds[20], oa[20], ob[20])
              + slotDiff(ds[21], oa[21], ob[21])
              + slotDiff(ds[22], oa[22], ob[22])
              + slotDiff(ds[23], oa[23], ob[23])
              + slotDiff(ds[24], oa[24], ob[24])
              + slotDiff(ds[25], oa[25], ob[25])
              + slotDiff(ds[26], oa[26], ob[26])
              + slotDiff(ds[27], oa[27], ob[27])
              + slotDiff(ds[28], oa[28], ob[28])
              + slotDiff(ds[29], oa[29], ob[29])
              + slotDiff(ds[30], oa[30], ob[30])
              + slotDiff(ds[31], oa[31], ob[31]);
  assert(count >= k, "too few differing fields");
  const diffKey = persistentHash<DocumentDiffClaim>(DocumentDiffClaim {
    tag:            20,
    record_key_a: record_key_a,
    content_root_a: anchorA.root,
    record_key_b: record_key_b,
    content_root_b: anchorB.root,
    schema_id:      schemaRoot,
    k:              k
  });
  recordClaim(diffKey, valid_until);
}
