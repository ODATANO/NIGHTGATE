.git
node_modules
db/*.db
db/*.db-*
# mirrors .gitignore: hand-taken DB backups, schema-delta/VACUUM copies and
# wallet-state dumps carry live operational data and must never enter an image
db/*.bak
db/*.bak-*
db/*.backup-*
db/backup-*
db/walletstate-*.json
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
# recursive: a real .env next to deploy templates (deploy/contabo/) must
# never enter the context either; only the committed examples are allowed in
**/.env
**/.env.*
!**/.env.example
coverage
docs
test
@cds-models
# .dockerignore patterns are rooted (unlike .gitignore): **/ is needed to
# catch logs in subdirectories, e.g. local serve logs under db/
**/*.log
npm-debug.log*
# local experiments and deploy-time copies of foreign contracts (see .gitignore)
scratch
contracts/ping
contracts/mint
contracts/mint2
contracts/mint3
contracts/mint4
OPERATIONS.local.md
# never part of the image: the generated client package, deployment
# templates, CI definitions and local one-off scripts
packages
deploy
.github
scripts/zz-*
# local notes, agent files, wallet files and one-off probes (all gitignored) stay out of every image
local_docs
.claude
.vscode
.idea
CLAUDE.md
AGENTS.md
**/*.local.md
**/*.local.json
presync
db/enhancements.md
scripts/probe-*.mjs
!scripts/probe-indexer.mjs
scripts/split-night-utxos.mjs
.ng-types-probe
