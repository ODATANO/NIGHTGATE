{
  "name": "@odatano/nightgate",
  "version": "0.47.7",
  "private": true,
  "description": "Midnight blockchain indexer and transaction service with an OData V4 API, built on SAP CAP",
  "homepage": "https://github.com/ODATANO/NIGHTGATE#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/NIGHTGATE.git"
  },
  "license": "Apache-2.0",
  "author": "Max Weber <max@maxalexweber.de>",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "scripts": {
    "clean": "node scripts/clean-build-artifacts.js",
    "prestart": "npm run build",
    "start": "npm run serve",
    "dev": "node scripts/dev.mjs",
    "dev:default-heap": "npm run cds:watch",
    "build": "npm run cds:types && tsc -p tsconfig.build.json",
    "serve": "npm run cds:serve",
    "serve:sync": "node scripts/serve.mjs",
    "sync:start": "node --env-file=.env scripts/start-wallet-sync.mjs",
    "sync:probe": "node scripts/probe-indexer.mjs",
    "cds:watch": "cds watch",
    "cds:serve": "cds-serve",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "build:types": "npm run cds:types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "cds deploy --to sqlite:db/midnight.db",
    "pretest": "npm run build",
    "test": "vitest run --coverage",
    "test:unit": "npm run build && vitest run test/unit",
    "smoke:sdk": "node scripts/smoke-test-sdk.mjs",
    "integration:providers": "node scripts/integration-test-providers.mjs",
    "integration:wallet-keys": "node scripts/integration-test-wallet-keys.mjs",
    "integration:wallet-facade": "node scripts/integration-test-wallet-facade.mjs",
    "integration:contract-registry": "node scripts/integration-test-contract-registry.mjs",
    "integration:connector-routes": "node scripts/integration-test-connector-routes.mjs",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "check:browser-types": "node scripts/check-browser-types.mjs",
    "check:server": "node --env-file-if-exists=.env scripts/check-server.mjs",
    "check:server:hosted": "node --env-file-if-exists=.env scripts/check-server.mjs https://api.nightgate.dev",
    "integration:schema-delta": "node scripts/integration-test-schema-delta.mjs",
    "integration:postgres": "node scripts/integration-test-postgres.mjs",
    "deploy:e2e": "node --env-file=.env scripts/run-deploy-e2e.mjs",
    "field-predicate-batch:e2e": "node --env-file=.env scripts/run-field-predicate-batch-e2e.mjs",
    "membership:e2e": "node --env-file=.env scripts/run-membership-e2e.mjs",
    "document-diff:e2e": "node --env-file=.env scripts/run-document-diff-e2e.mjs",
    "anchor-batch:e2e": "node --env-file=.env scripts/run-rebind-repro-e2e.mjs",
    "dust-wedge:e2e": "node --env-file=.env scripts/run-dust-wedge-e2e.mjs",
    "agent-layer:e2e": "node --env-file=.env scripts/run-agent-layer-e2e.mjs",
    "disclosure:e2e": "node --env-file=.env scripts/run-disclosure-e2e.mjs",
    "state-verify:e2e": "node --env-file=.env scripts/run-state-verification-e2e.mjs",
    "wasm-proving:e2e": "node --env-file=.env scripts/run-wasm-proving-e2e.mjs",
    "wasm-contract:e2e": "node --env-file=.env scripts/run-wasm-contract-e2e.mjs",
    "wasm-zswap:e2e": "node --env-file=.env scripts/run-wasm-zswap-e2e.mjs",
    "test:pg-idempotency": "node scripts/test-postgres-idempotency.mjs",
    "lint": "eslint . && node scripts/check-any-baseline.mjs",
    "check:release": "npm run build && npm run lint && npm run typecheck && npm test && npm run integration:schema-delta && npm run check:browser && npm run check:slim && npm run check:browser-types",
    "check:release:full": "npm run check:release && npm run integration:postgres",
    "integration:derive-wallet-info": "node --env-file=.env scripts/integration-test-derive-wallet-info.mjs",
    "integration:utxo-identity": "node scripts/integration-test-utxo-identity.mjs",
    "check:fresh-tree": "bash scripts/check-fresh-tree.sh",
    "txbuilder:e2e": "node --env-file=.env scripts/run-txbuilder-e2e.mjs",
    "burst-sponsor:e2e": "node --env-file=.env scripts/run-burst-sponsor-e2e.mjs",
    "sponsored-deploy:e2e": "node --env-file=.env scripts/run-sponsored-deploy-e2e.mjs",
    "build:slim": "node scripts/build-slim-package.mjs",
    "check:slim": "npm run build:slim && node scripts/check-slim-package.mjs",
    "mint-token:e2e": "node --env-file=.env scripts/run-mint-token-e2e.mjs",
    "width32:e2e": "node --env-file=.env scripts/run-width32-e2e.mjs",
    "config:table": "node scripts/print-config-table.mjs --write",
    "errors:table": "node scripts/print-error-codes.mjs --write",
    "client:types": "node scripts/print-client-types.mjs --write"
  },
  "dependencies": {
    "@cap-js/postgres": "^3.0.1",
    "@cap-js/sqlite": "^3",
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/midnight-js-contracts": "5.0.3",
    "@midnightntwrk/midnight-js-dapp-connector-proof-provider": "5.0.3",
    "@midnightntwrk/midnight-js-fetch-zk-config-provider": "5.0.3",
    "@midnightntwrk/midnight-js-http-client-proof-provider": "5.0.3",
    "@midnightntwrk/midnight-js-indexer-public-data-provider": "5.0.3",
    "@midnightntwrk/midnight-js-node-zk-config-provider": "5.0.3",
    "@midnightntwrk/midnight-js-protocol": "5.0.3",
    "@midnightntwrk/midnight-js-types": "5.0.3",
    "@midnightntwrk/midnight-js-utils": "5.0.3",
    "@midnightntwrk/ledger-v8": "8.1.3",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.1",
    "@midnightntwrk/wallet-sdk-capabilities": "4.0.1",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.1.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.1",
    "@midnightntwrk/wallet-sdk-hd": "4.0.0",
    "@midnightntwrk/wallet-sdk-node-client": "2.0.1",
    "@midnightntwrk/wallet-sdk-prover-client": "2.0.1",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.1",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.1",
    "@midnightntwrk/zkir-v2": "2.2.0",
    "@midnightntwrk/zkir-v3": "3.2.1",
    "@noble/hashes": "^1.8.0",
    "@odatano/cap-auth": "^0.1.0",
    "@odatano/contract-attestation-vault": "0.2.0",
    "@odatano/contract-attestation-vault-32": "0.2.0",
    "@odatano/contract-counter": "0.2.0",
    "@odatano/contract-holder-registry": "0.2.0",
    "@odatano/contract-kit": "0.2.2",
    "@odatano/contract-token-factory": "0.2.0",
    "@polkadot/types": "^16.5.6",
    "@polkadot/wasm-crypto": "^7.5.4",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "@scure/base": "^2.2.0",
    "better-sqlite3": "^12.6.2",
    "bip39": "^3.1.0",
    "effect": "^3.21.4",
    "generic-pool": "^3.9.0",
    "rxjs": "^7.8.2",
    "superjson": "^2.2.7",
    "ws": "^8"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-typer": "^0.40.0",
    "@cap-js/cds-types": "^0.18.0",
    "@odatano/contract-shielded-token": "0.2.0",
    "@types/node": "^22",
    "@types/ws": "^8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.11.0",
    "express": "^4.22.2",
    "globals": "^14.0.0",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.70.1",
    "undici": "^8.9.0",
    "vitest": "^4.1.10"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db/midnight.db"
        },
        "client": {
          "timeout": 30000
        }
      },
      "nightgate": {
        "contracts": {
          "counter": {
            "package": "@odatano/contract-counter"
          },
          "attestation-vault": {
            "package": "@odatano/contract-attestation-vault"
          },
          "attestation-vault-32": {
            "package": "@odatano/contract-attestation-vault-32"
          },
          "holder-registry": {
            "package": "@odatano/contract-holder-registry"
          },
          "token-factory": {
            "package": "@odatano/contract-token-factory"
          }
        }
      }
    },
    "features": {
      "use_generic_pool": true
    },
    "[development]": {
      "requires": {
        "auth": {
          "kind": "dummy"
        },
        "nightgate": {
          "contracts": {
            "shielded-token": {
              "package": "@odatano/contract-shielded-token"
            }
          }
        }
      }
    },
    "[test]": {
      "requires": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "dummy"
        }
      }
    },
    "odata": {
      "version": "v4"
    },
    "typer": {
      "outputDirectory": "@cds-models",
      "propertiesOptional": false,
      "IEEE754Compatible": true
    }
  },
  "bugs": {
    "url": "https://github.com/ODATANO/NIGHTGATE/issues"
  },
  "overrides": {
    "qs": "^6.17.1",
    "body-parser@1": "^1.20.9"
  }
}
